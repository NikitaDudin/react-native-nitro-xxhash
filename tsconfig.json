{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "react"]
  },
  "include": ["index.ts", "src/**/*.ts", "native/**/*.ts"],
  "exclude": ["node_modules", "lib", "nitrogen"]
}
