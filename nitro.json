{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["xxhash"],
  "ios": {
    "iosModuleName": "NitroFileHash"
  },
  "android": {
    "androidNamespace": ["filehash"],
    "androidCxxLibName": "NitroFileHash"
  },
  "autolinking": {
