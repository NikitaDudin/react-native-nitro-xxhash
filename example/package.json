{
  "name": "nitro-xxhash-example",
  "version": "0.1.2",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node --dns-result-order=ipv4first node_modules/expo/bin/cli start --localhost --port 8083",
    "prebuild": "expo prebuild --no-clean",
    "ios": "expo prebuild --no-clean --platform ios && node --dns-result-order=ipv4first node_modules/expo/bin/cli run:ios --port 8083",
    "android": "expo prebuild --no-clean --platform android && node --dns-result-order=ipv4first node_modules/expo/bin/cli run:android --port 8083",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "58.0.20",
    "expo-file-system": "58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-nitro-xxhash": "file:.artifacts/react-native-nitro-xxhash.tgz",
    "react-native-safe-area-context": "5.10.1"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
